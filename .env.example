# ------------------------------------------------------------------
# Trusting — environment configuration
# Copy to .env and fill in the values. Never commit your real .env.
# ------------------------------------------------------------------

# Public URL of this installation (no trailing slash). Used for links in
# emails, OAuth redirect URIs and CSRF origin checks.
APP_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://trusting:change-me@db:5432/trusting

# Secrets. Generate with:  openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

# ---- File storage ----
# "s3" for MinIO / AWS S3 / any S3-compatible service, "local" for a folder on disk.
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=trusting
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

# ---- Email (optional, used to notify requesters) ----
# Leave SMTP_HOST empty to disable email; approvals then show a link to copy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Trust Center <trust@example.com>"

# ---- Google Drive integration (optional) ----
# Redirect URI to register: ${APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft OneDrive integration (optional) ----
# Redirect URI to register: ${APP_URL}/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
