# ------------------------------------------------------------------
# Trusting — environment configuration
# Copy to .env and fill in the values. Never commit your real .env.
# ------------------------------------------------------------------

# Public URL of this installation (no trailing slash). Used for links in
# emails, OAuth redirect URIs and CSRF origin checks.
APP_URL=http://localhost:3000

# PostgreSQL. With docker-compose.yml the database container uses these
# values; keep DATABASE_URL in sync with POSTGRES_PASSWORD.
POSTGRES_USER=trusting
POSTGRES_PASSWORD=
POSTGRES_DB=trusting
DATABASE_URL=postgresql://trusting:change-me@db:5432/trusting

# Secrets. Generate with:  openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

# ---- File storage ----
# "s3" for any S3-compatible service (the bundled Garage container, AWS S3,
# MinIO, Cloudflare R2, Backblaze B2, ...), "local" for a folder on disk.
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT=http://garage:3900
S3_REGION=us-east-1
S3_BUCKET=trusting
# For the bundled Garage container the key ID must be "GK" + 24 hex chars and
# the secret 64 hex chars:  echo "GK$(openssl rand -hex 12)"  /  openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Internal secret for the bundled Garage container:  openssl rand -hex 32
GARAGE_RPC_SECRET=
MAX_UPLOAD_MB=25

# ---- Email (optional, used to notify requesters) ----
# Leave SMTP_HOST empty to disable email; approvals then show a link to copy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Trust Center <trust@example.com>"

# ---- Google Drive integration (optional) ----
# Redirect URI to register: ${APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft OneDrive integration (optional) ----
# Redirect URI to register: ${APP_URL}/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
